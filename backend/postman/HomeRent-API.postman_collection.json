          "name": "List (Tenant)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/bookings?search=",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"],
              "query": [
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "List (Owner)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/bookings?search=",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"],
              "query": [
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
